FROM python:3.12-slim-bookworm
WORKDIR /app
COPY orchestrator/requirements.txt orchestrator/requirements.txt
RUN pip install --no-cache-dir -r orchestrator/requirements.txt
COPY orchestrator ./orchestrator
ENV PYTHONUNBUFFERED=1 HOST=0.0.0.0 PORT=8000 COMPANY_TAGS_PATH=/app/data/processed/company_tags.csv
EXPOSE 8000
ENTRYPOINT ["python", "-m", "orchestrator"]
